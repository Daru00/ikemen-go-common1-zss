# Zantei State Script - Modern Edition
# Syntax highlighter for Notepad++: https://github.com/ikemen-engine/zss_npp
#-------------------------------------------------------------------------------
# ZSS code needs to use UTF-8 character encoding system.
# && and || are short-circuit evaluations.
# The part enclosed in ignoreHitPause{} will be executed even during hit pause.
# Ifs prefixed with ignoreHitPause will also be executed.
# explod state controller allows arbitrary specification of ignoreHitPause.
# ignoreHitPause and/or persistent(x) followed by if block affects nested ifs.
# varSet and varAdd assignments should be replaced with :=, followed by value.
# The assignment expression must be followed by a ; sign.
# Local variables can be assigned with 'let variable name = trigger expression;'
# Local variables calls via $variableName can be used in the trigger expression.
# Local variable assignment with := is not possible in the trigger expression.
# Local variable names are [a-z_][0-9a-z_]* and assignment to _ is discarded.
# Local variables are up to 256, including arguments and return values.
# Functions can only call predefined functions, so recursion is not possible.
# In case of repeated function names, the first loaded one overrides others.
# for/while loops (with break and continue) and switch statements are supported.
#
#===============================================================================
# MODERN SYSTEMS (SF6 / Garou CotW / Guilty Gear Strive / KOF XV inspired)
#===============================================================================
# Everything is self-contained in this file and works with ZERO changes to the
# character's CMD or code. It only reads commands that every Ikemen character
# already has: x y z a b c, holdfwd/holdback/holddown/holdup, recovery.
# (Button layout: x/y/z = LP/MP/HP, a/b/c = LK/MK/HK.)
#
#  INPUTS
#   MP+MK  (y+b)              Drive Parry (ground, tap)  /  Air Dash (in air,
#                              hold back for a back air dash)
#   HP+HK  (z+c)              Drive Impact (armored, launches)
#   Fwd + HP+HK while blocking Drive Reversal (guard cancel, 2 bars)
#   Fwd + MP+MK on hit/block  Drive Rush cancel from an attack (3 bars)
#   Fwd + MP/MK in a parry    Drive Rush from parry (1 bar)
#   recovery in hitstun       Overdrive Burst (3 bars, pushes opponent away)
#   Tap back right before a hit lands   Just Defend / Instant Block
#   recovery / direction while lying down  Quick rise
#
#  GAUGE (Drive Gauge, 6 bars, no extra files needed)
#   sysFVar(0) = gauge 0..6000     sysFVar(1) = burnout flag
#   sysFVar(2) = just-defend flag  sysVar(3) = air dashes used
#   sysVar(4)  = frames back has been held (just-defend timer)
#   sysVar(0..2) are still used as scratch by the original states.
#
#  NEW STATES: 6000 air dash, 6100 parry, 6110 parry hit, 6111 perfect parry,
#   6120 parry whiff, 6200 drive rush, 6300/6301/6310 drive impact,
#   6400 drive reversal, 6410 burst, 6500 drive stun (guard crush).
#  Optional animations (all have fallbacks): 6000/6001 air dash fwd/back,
#   6100/6101 parry stand/crouch, 6110 parry hit, 6120/6121 parry whiff,
#   6200 rush, 6300/6301 impact, 6410 burst, 5300 or 6500 drive stun.
#
#  TUNABLES live in the [StateDef -2] block at the end of this file and in the
#  comments of each new state (costs, windows, damage).
#-------------------------------------------------------------------------------
# Stand
[StateDef 0; type: S; physics: S; sprpriority: 0;]

if cond(anim = 5, animTime = 0, anim != 0) {
	changeAnim{value: 0}
}
if time = 0 {
	velSet{y: 0}
}
if time = 4 || abs(vel x) < const(movement.stand.friction.threshold) {
	velSet{x: 0}
}
if !alive {
	changeState{value: 5050; ctrl: 0}
}

#-------------------------------------------------------------------------------
# Stand to Crouch
[StateDef 10; type: C; physics: C; anim: 10;]

if time = 0 {
	velMul{x: .75}
}
if abs(vel x) < const(movement.crouch.friction.threshold) {
	velSet{x: 0}
}
if animTime = 0 {
	changeState{value: 11}
}

#-------------------------------------------------------------------------------
# Crouching
[StateDef 11; type: C; physics: C; anim: 11; sprpriority: 0;]

if anim = 6 && animTime = 0 {
	changeAnim{value: 11}
}
if abs(vel x) < const(movement.crouch.friction.threshold) {
	velSet{x: 0}
}

#-------------------------------------------------------------------------------
# Crouch to Stand
[StateDef 12; type: S; physics: S; anim: 12;]

if animTime = 0 {
	changeState{value: 0}
}

#-------------------------------------------------------------------------------
# Walk
[StateDef 20; type: S; physics: S; sprpriority: 0;]

if command = "holdback" {
	velSet{x: const(velocity.walk.back.x)}
} else if command = "holdfwd" {
	velSet{x: const(velocity.walk.fwd.x)}
}
if vel x > 0 {
	if cond(anim = 5, animTime = 0, anim != 20) {
		changeAnim{value: 20}
	}
} else if vel x < 0 {
	if cond(anim = 5, animTime = 0, anim != 21) {
		changeAnim{value: 21}
	}
}

#-------------------------------------------------------------------------------
# Jump Start
[StateDef 40; type: S; physics: S; anim: 40; ctrl: 0; sprpriority: 1; facep2: 1;]

if time = 0 {
	sysVar(1) := 0;
}
if command = "holdback" {
	sysVar(1) := -1;
} else if command = "holdfwd" {
	sysVar(1) := 1;
}
if animTime = 0 {
	if sysVar(1) = 0 {
		let x = const(velocity.jump.neu.x);
	} else if sysVar(1) = 1 {
		if prevStateNo = 100 {
			let x = const(velocity.runjump.fwd.x);
		} else {
			let x = const(velocity.jump.fwd.x);
		}
	} else {
		let x = const(velocity.jump.back.x);
	}
	velSet{x: $x; y: const(velocity.jump.y)}
	changeState{value: 50; ctrl: 1}
}

#-------------------------------------------------------------------------------
# AirJump Start
[StateDef 45; type: A; physics: N; ctrl: 0; velset: 0, 0;]

changeAnim{value: ifElse(selfAnimExist(44), 44, 41)}
if time = 0 {
	sysVar(1) := 0;
}
if command = "holdback" {
	sysVar(1) := -1;
} else if command = "holdfwd" {
	sysVar(1) := 1;
}
if time = 2 {
	if sysVar(1) = 0 {
		let x = const(velocity.airjump.neu.x);
	} else if sysVar(1) = 1 {
		let x = const(velocity.airjump.fwd.x);
	} else {
		let x = const(velocity.airjump.back.x);
	}
	velSet{x: $x; y: const(velocity.airjump.y)}
	changeState{value: 50; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Jump Up
[StateDef 50; type: A; physics: A;]

if time = 0 {
	sysVar(1) := 0;
	changeAnim{value: cond(vel x = 0, 41, ifElse(vel x > 0, 42, 43))}
}
persistent(0) if vel y > const240p(-2) && selfAnimExist(anim + 3) && anim = [41, 43] {
	changeAnim{value: anim + 3}
}

#-------------------------------------------------------------------------------
# Jump Down (empty state for compatibility)
[StateDef 51; type: A; physics: A;]

null{}

#-------------------------------------------------------------------------------
# Jump Land
[StateDef 52; type: S; physics: S; ctrl: 0; anim: 47;]

if time = 0 {
	velSet{y: 0}
	posSet{y: 0}
} else if time = 3 {
	ctrlSet{value: 1}
}
if abs(vel x) < const(movement.stand.friction.threshold) {
	velSet{x: 0}
}
if animTime = 0 {
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Run forward
[StateDef 100; type: S; physics: S; anim: 100; sprpriority: 1;]

velSet{x: const(velocity.run.fwd.x)}
assertSpecial{flag: noWalk; flag2: noAutoTurn}
if command != "holdfwd" {
	changeState{value: 0}
}

#-------------------------------------------------------------------------------
# Hop backwards (strike/projectile invulnerable for the first 6 frames)
[StateDef 105; type: A; physics: A; ctrl: 0; anim: 105; sprpriority: 1;]

if time = 0 {
	velSet{x: const(velocity.run.back.x); y: const(velocity.run.back.y)}
} else if time = 2 {
	ctrlSet{value: 1}
}
if time < 6 {
	notHitBy{value: SCA, NA, SA, HA, NP, SP, HP; time: 1}
}
if vel y > 0 && pos y >= 0 {
	changeState{value: 106}
}

#-------------------------------------------------------------------------------
# Hop backwards (land)
[StateDef 106; type: S; physics: S; ctrl: 0; anim: 47;]

if abs(vel x) < const(movement.stand.friction.threshold) {
	velSet{x: 0}
}
if time = 0 {
	velSet{y: 0}
	posSet{y: 0}
} else if time = 2 {
	makeDust{pos: 0, 0; spacing: 1}
} else if time = 7 {
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Run up (Deprecated in DosMugen)
# TODO: Make this work now that Z-Axis is back.
[StateDef 110; type: S; physics: N;]

if time = 0 {
	ctrlSet{value: 0}
	changeAnim{value: 110}
	#hitBy{value: SCA, NT, ST, HT; time: 30}
	velSet{x: 0; z: -7}
}
velMul{z: 0.8}
if animTime = -8 {
	velSet{z: 0}
} else if animTime = 0 {
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Run down (Deprecated in DosMugen)
# TODO: Make this work now that Z-Axis is back.
[StateDef 115; type: S; physics: N;]

if time = 0 {
	ctrlSet{value: 0}
	changeAnim{value: 115}
	#hitBy{value: SCA, NT, ST, HT; time: 30}
	velSet{x: 0; z: 7}
}
velMul{z: 0.8}
if animTime = -8 {
	velSet{z: 0}
} else if animTime = 0 {
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
[Function IkSys_HiToLoAndLoToHi()]
if command = "holddown" {
	if stateType = S {
		stateTypeSet{statetype: C; physics: C}
	}
} else if stateType = C {
	stateTypeSet{statetype: S; physics: S}
}

#-------------------------------------------------------------------------------
[Function IkSys_StopGuarding()]
if command != "holdback" || !inGuardDist {
	changeState{value: 140}
}

#-------------------------------------------------------------------------------
# GUARD (start)
[StateDef 120; type: U; physics: U;]

call IkSys_HiToLoAndLoToHi();
if time = 0 {
	changeAnim{value: 120 + (stateType = C) + (stateType = A) * 2}
	if stateType = S {
		stateTypeSet{physics: S}
	} else if stateType = C {
		stateTypeSet{physics: C}
	} else if stateType = A {
		stateTypeSet{physics: A}
	}
}
if animTime = 0 {
	changeState{value: 130 + (stateType = C) + (stateType = A) * 2}
}
call IkSys_StopGuarding();

#-------------------------------------------------------------------------------
# Stand guard (guarding)
[StateDef 130; type: S; physics: S;]

if anim != 130 {
	changeAnim{value: 130}
}
if command = "holddown" {
	changeState{value: 131}
}
call IkSys_StopGuarding();

#-------------------------------------------------------------------------------
# Crouch guard (guarding)
[StateDef 131; type: C; physics: C;]

if anim != 131 {
	changeAnim{value: 131}
}
if command != "holddown" {
	changeState{value: 130}
}
call IkSys_StopGuarding();

#-------------------------------------------------------------------------------
[Function IkSys_AirGuardLand()]
velAdd{y: const(movement.yAccel)}
if sysVar(0) := (pos y >= 0 && vel y > 0) {
	velSet{y: 0}
	posSet{y: 0}
	changeState{value: ifElse(command = "holdback" && inGuardDist, 130, 52)}
}

#-------------------------------------------------------------------------------
# Air guard (guarding)
[StateDef 132; type: A; physics: N;]

if anim != 132 {
	changeAnim{value: 132}
}
call IkSys_AirGuardLand();
call IkSys_StopGuarding();

#-------------------------------------------------------------------------------
# Guard (end)
[StateDef 140; type: U; physics: U; ctrl: 1;]

call IkSys_HiToLoAndLoToHi();
if time = 0 {
	changeAnim{value: 140 + (stateType = C) + (stateType = A) * 2}
	if stateType = S {
		stateTypeSet{physics: S}
	} else if stateType = C {
		stateTypeSet{physics: C}
	} else if stateType = A {
		stateTypeSet{physics: A}
	}
}

#-------------------------------------------------------------------------------
[Function IkSys_GuardShaking(anim)]
changeAnim{value: $anim}
if hitShakeOver {
	changeState{value: 151 + 2 * (command = "holddown")}
}
call IkSys_HiToLoAndLoToHi();

#-------------------------------------------------------------------------------
# A Just Defend (sysFVar(2) = 1) recovers faster than a normal block.
[Function IkSys_GuardKnockedBack(nextState)]
if time = 0 {
	hitVelSet{x: 1}
}
if time = getHitVar(slideTime) || hitOver {
	velSet{x: 0}
}
if time = getHitVar(ctrlTime) {
	ctrlSet{value: 1}
}
call IkSys_HiToLoAndLoToHi();
if hitOver || (sysFVar(2) = 1 && time >= 6) {
	changeState{value: $nextState; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Stand guard hit (shaking)
[StateDef 150; type: S; movetype: H; physics: N; velset: 0, 0;]

call IkSys_GuardShaking(150);
if time = 0 {
	forceFeedback{waveform: square; time: 3}
}

#-------------------------------------------------------------------------------
# Stand guard hit (knocked back)
[StateDef 151; type: S; movetype: H; physics: S; anim: 150;]

call IkSys_GuardKnockedBack(130);

#-------------------------------------------------------------------------------
# Crouch guard hit (shaking)
[StateDef 152; type: C; movetype: H; physics: N; velset: 0, 0;]

call IkSys_GuardShaking(151);
if time = 0 {
	forceFeedback{waveform: square; time: 4}
}

#-------------------------------------------------------------------------------
# Crouch guard hit (knocked back)
[StateDef 153; type: C; movetype: H; physics: C; anim: 151;]

call IkSys_GuardKnockedBack(131);

#-------------------------------------------------------------------------------
# Air guard hit (shaking)
[StateDef 154; type: A; movetype: H; physics: N; velset: 0, 0;]

changeAnim{value: 152}
if hitShakeOver {
	changeState{value: 155}
}
if time = 0 {
	forceFeedback{waveform: square; time: 4}
}

#-------------------------------------------------------------------------------
# Air guard hit (knocked away)
[StateDef 155; type: A; movetype: H; physics: N; anim: 152;]

if time = 0 {
	hitVelSet{x: 1; y: 1}
}
if time = getHitVar(ctrlTime) {
	ctrlSet{value: 1}
}
call IkSys_AirGuardLand();

#-------------------------------------------------------------------------------
# Lose (time over)
[StateDef 170; type: S; ctrl: 0; anim: 170; velset: 0, 0;]

notHitBy{value: SCA; time: 1}

#-------------------------------------------------------------------------------
# Draw game (time over)
[StateDef 175; type: S; ctrl: 0; velset: 0, 0;]

if time = 0 {
	if !selfAnimExist(175) { # If anim 170 does not exist, go to SD 170,
		changeState{value: 170}
	}
	changeAnim{value: 175}
}
notHitBy{value: SCA; time: 1}

#-------------------------------------------------------------------------------
# Pre-intro
[StateDef 190; type: S; ctrl: 0; velset: 0, 0;]

if selfAnimExist(190) {
	changeAnim{value: 190}
}
if time = 0 {
	changeState{value: 191}
}

#-------------------------------------------------------------------------------
# Intro (override this state to give character an intro)
[StateDef 191; type: S; ctrl: 0;]

if time = 0 {
	changeState{value: 0}
}

#-------------------------------------------------------------------------------
[Function IkSys_GetHitShaking(lAnim)]
if time = 0 {
	if getHitVar(animType) = [4, 5] &&
		selfAnimExist(5051 + getHitVar(animType) - 4) {
		changeAnim{value: 5051 + getHitVar(animType) - 4}
	} else if getHitVar(animType) = [3, 5] {
		changeAnim{value: 5030}
	} else {
		changeAnim{value: $lAnim + getHitVar(animType)}
	}
} else {
	changeAnim{value: anim}
}

#-------------------------------------------------------------------------------
[Function IkSys_GetHitKnockedBack(lAnim, nextState)]
if time = 0 {
	hitVelSet{x: 1}
}
if animTime = 0 {
	changeAnim{value: $lAnim + getHitVar(animType)}
}
if time >= getHitVar(slideTime) {
	velMul{x: .6}
}
if hitOver {
	velSet{x: 0}
	DefenceMulSet{value: 1}
	changeState{value: $nextState; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Stand get-hit (shaking)
[StateDef 5000; type: S; movetype: H; physics: N; velset: 0, 0;]

call IkSys_GetHitShaking(ifElse(getHitVar(groundType) = 1, 5000, 5010));
if (time = 0 && (getHitVar(yVel) || getHitVar(fall))) || pos y != 0 {
	stateTypeSet{statetype: A}
}
if anim = 5000 || anim = 5010 {
	forceFeedback{time: 6; waveform: square}
} else if anim = 5001 || anim = 5011 {
	forceFeedback{time: 8; waveform: sinesquare; ampl: 110,-1,-.3}
} else if anim = 5012 || anim = 5002 || anim = 5030 {
	forceFeedback{time: 15; waveform: sinesquare; ampl: 140}
}
if hitShakeOver {
	changeState{value: ifElse(getHitVar(yVel) || getHitVar(fall), 5030, 5001)}
}

#-------------------------------------------------------------------------------
# Stand get-hit (knocked back)
[StateDef 5001; type: S; movetype: H; physics: S;]

call IkSys_GetHitKnockedBack(5005 + (getHitVar(groundType) = 2) * 10, 0);

#-------------------------------------------------------------------------------
# Crouch get-hit (shaking)
[StateDef 5010; type: C; movetype: H; physics: N; velset: 0, 0;]

call IkSys_GetHitShaking(5020);
if (time = 0 && (getHitVar(yVel) || getHitVar(fall))) || pos y != 0 {
	stateTypeSet{statetype: A}
}
if hitShakeOver {
	changeState{value: ifElse(getHitVar(yVel) || getHitVar(fall), 5030, 5011)}
}
if anim = 5020 {
	forceFeedback{time: 6; waveform: square}
} else if anim = 5021 {
	forceFeedback{time: 8; waveform: sinesquare; ampl: 110,-1,-.3}
} else if anim = 5022 {
	forceFeedback{time: 15; waveform: sinesquare; ampl: 140}
}

#-------------------------------------------------------------------------------
# Crouch get-hit (knocked back)
[StateDef 5011; type: C; movetype: H; physics: C;]

call IkSys_GetHitKnockedBack(5025, 11);

#-------------------------------------------------------------------------------
# Air get-hit (shaking)
[StateDef 5020; type: A; movetype: H; physics: N; velset: 0, 0;]

call IkSys_GetHitShaking(ifElse(getHitVar(airType) = 1, 5000, 5010));
if hitShakeOver {
	changeState{value: 5030}
}
if anim = 5000 || anim = 5010 {
	forceFeedback{time: 6; waveform: square}
} else if anim = 5001 || anim = 5011 {
	forceFeedback{time: 8; waveform: sinesquare; ampl: 110,-1,-.3}
} else if anim = 5012 || anim = 5002 || anim = 5030 || anim = [5051,5059] {
	forceFeedback{time: 15; waveform: sinesquare; ampl: 140}
}

#-------------------------------------------------------------------------------
# Air get-hit (knocked away)
[StateDef 5030; type: A; movetype: H; physics: N; ctrl: 0;]

if anim != [5000, 5199] && selfAnimExist(5030) {
	changeAnim{value: 5030}
}
if time = 0 {
	hitVelSet{x: 1; y: 1}
} else {
	velAdd{y: getHitVar(yAccel)}
}
if hitOver || vel y > 0 && pos y >= const(movement.air.gethit.groundlevel) {
	if hitFall {
		changeState{value: 5050}
	} else {
		changeState{value: 5040}
	}
}
if animTime = 0 {
	changeState{value: 5035}
}

#-------------------------------------------------------------------------------
# Air get-hit (transition)
[StateDef 5035; type: A; movetype: H; physics: N;]

if time = 0 && selfAnimExist(5035) && anim != [5051, 5059] && anim != 5090 {
	changeAnim{value: 5035}
}
if time > 0 {
	velAdd{y: getHitVar(yAccel)}
}
if hitOver || animTime = 0 ||
	vel y > 0 && pos y >= const(movement.air.gethit.groundlevel) ||
	time = 0 && anim != 5035 {
	if hitFall {
		changeState{value: 5050}
	} else {
		changeState{value: 5040}
	}
}

#-------------------------------------------------------------------------------
# Air get-hit (recovering in air, not falling)
[StateDef 5040; type: A; movetype: H; physics: N;]

if !alive {
	changeState{value: 5050; ctrl: 0}
}
if animTime = 0 && anim != 5040 || time = 0 && anim != 5035 {
	changeAnim{value: 5040}
}
if hitOver {
	ctrlSet{value: 1}
	stateTypeSet{movetype: I}
}
if time > 0 {
	velAdd{y: getHitVar(yAccel)}
}
if vel y > 0 && pos y >= 0 {
	changeState{value: 52}
}

#-------------------------------------------------------------------------------
# Air get-hit (falling)
[StateDef 5050; type: A; movetype: H; physics: N;]

if animTime = 0 && anim = 5035 || time = 0 && anim != 5035 &&
	anim != [5051, 5059] && anim != [5061, 5069] && anim != 5090 {
	changeAnim{value: 5050}
}
persistent(0) if anim = [5050, 5059] && vel y >= ifElse(anim = 5050,
	const240p(1), const240p(-2)) && selfAnimExist(anim + 10) {
	changeAnim{value: anim + 10}
}
if time > 0 {
	velAdd{y: getHitVar(yAccel)}
}
if alive && canRecover && command = "recovery" {
	if vel y > 0 &&
		pos y >= const(movement.air.gethit.groundrecover.ground.threshold) {
		changeState{value: 5200}
	}
	if vel y > const(movement.air.gethit.airrecover.threshold) {
		changeState{value: 5210}
	}
}
if vel y > 0 && pos y >= cond(anim = [5051, 5059] || anim = [5061, 5069], 0, const(movement.air.gethit.groundlevel)) {
	changeState{value: 5100}
}

#-------------------------------------------------------------------------------
# Tripped get-hit (shaking)
[StateDef 5070; type: A; movetype: H; physics: N; velset: 0, 0;]

changeAnim{value: 5070}
if hitShakeOver {
	changeState{value: 5071}
}
if time = 0 {
	forceFeedback{time: 12; waveform: sinesquare; ampl: 140}
}

#-------------------------------------------------------------------------------
# Tripped get-hit (knocked away)
[StateDef 5071; type: A; movetype: H; physics: N;]

if time = 0 {
	hitVelSet{x: 1; y: 1}
} else {
	velAdd{y: getHitVar(yAccel)}
}
if vel y > 0 && pos y >= const(movement.air.gethit.trip.groundlevel) {
	changeState{value: 5110}
}

#-------------------------------------------------------------------------------
[Function IkSys_SelfAnimExistAddMod10(cond, base) ret]
let ret = cond($cond && selfAnimExist($base + anim % 10),
	$base + anim % 10, $base);

#-------------------------------------------------------------------------------
# Downed get-hit (shaking)
[StateDef 5080; type: L; movetype: H; physics: N; velset: 0, 0;]

if time = 0 {
	sysVar(2) := ifElse(getHitVar(yVel) = 0, 5080, 5090);
	if (anim = [5081, 5089] || anim = [5111, 5119]) &&
		selfAnimExist(sysVar(2) + anim % 10) {
		sysVar(2) := sysVar(2) + anim % 10;
	}
	if sysVar(2) = 5090 && !selfAnimExist(5090) {
		sysVar(2) := 5030;
	}
}
changeAnim{value: sysVar(2)}
if hitShakeOver {
	if getHitVar(yVel) = 0 {
		changeState{value: 5081}
	} else {
		changeState{value: 5030}
	}
}

#-------------------------------------------------------------------------------
# Downed get-hit (knocked back)
[StateDef 5081; type: L; movetype: H; physics: C;]

if time = 0 {
	hitVelSet{x: 1}
	sysVar(0) := 1;
}
if hitOver {
	velSet{x: 0}
	changeState{value: 5110}
}

#-------------------------------------------------------------------------------
[Function IkSys_HitGroundEffect(vely)]
if mugenVersion(major) = 0 {
	gameMakeAnim{
		value: 60 + ($vely > 5) + ($vely > 14);
		pos: 0, 0;
		under: $vely <= 14;
	}
} else {
	explod{
		anim: F(60 + ($vely > const240p(5)) + ($vely > const240p(14)));
		postype: none; #p1
		pos: pos x + cameraPos x, 0, pos z;
		facing: facing;
		sprpriority: ifElse($vely <= const240p(14), -10, 10);
	}
}
playSnd{value: F7, ($vely > const240p(5)) + ($vely > const240p(14))}

#-------------------------------------------------------------------------------
# Downed get-hit (hit ground from fall)
[StateDef 5100; type: L; movetype: H; physics: N;]

if time = 0 {
	if mugenVersion(major) = 0 && getHitVar(fall.yVel) = 0 && vel x > 1 {
		velSet{x: 1}
	}
	fallEnvShake{}
	sysVar(1) := floor(vel y);
	let a = call IkSys_SelfAnimExistAddMod10(anim = [5051, 5059] ||
		anim = [5061, 5069], 5100);
	changeAnim{value: $a}
	posSet{y: 0}
	velSet{y: 0}
	velMul{x: .75}
	if getHitVar(fall.yVel) = 0 {
		changeState{value: 5110}
	}
} else if time = 1 {
	call IkSys_HitGroundEffect(sysVar(1));
} else if time = 3 {
	hitFallDamage{}
}
posFreeze{}
if animTime = 0 {
	changeState{value: 5101}
}
if time = 0 {
	forceFeedback{waveform: sinesquare; ampl: 128,-3,-.2,.005; time: 20}
}

#-------------------------------------------------------------------------------
# Downed get-hit (bounce off ground)
[StateDef 5101; type: L; movetype: H; physics: N;]

if time = 0 {
	let a = call IkSys_SelfAnimExistAddMod10(anim = [5101, 5109], 5160);
	changeAnim{value: $a}
	hitFallVel{}
	posSet{y: const(movement.down.bounce.offset.y)}
	posAdd{x: const(movement.down.bounce.offset.x)}
}
if time > 0 {
	velAdd{y: const(movement.down.bounce.yAccel)}
}
if vel y > 0 && pos y >= const(movement.down.bounce.groundlevel) {
	changeState{value: 5110}
}

#-------------------------------------------------------------------------------
# Downed get-hit (lying down)
# Quick rise: press recovery or any direction shortly after landing.
[StateDef 5110; type: L; movetype: H; physics: N;]

persistent(0) if selfAnimExist(5110 + anim % 10) && anim = [5081, 5089] {
	changeAnim{value: 5110 + anim % 10}
}
if time = 0 {
	fallEnvShake{}
	if anim != [5110, 5119] {
		let a = call IkSys_SelfAnimExistAddMod10(anim = [5161, 5169], 5170);
		changeAnim{value: $a}
	}
	hitFallDamage{}
	posSet{y: 0}
	if getHitVar(fall.yVel) {
		sysVar(1) := floor(vel y);
	}
	if !sysVar(0) {
		call IkSys_HitGroundEffect(sysVar(1));
	}
	velSet{y: 0}
}
let atEq0OrSv0 = animTime = 0 || sysVar(0);
if $atEq0OrSv0 {
	persistent(0) if anim = [5171, 5179] && selfAnimExist(5110 + anim % 10) {
		changeAnim{value: 5110 + anim % 10}
	}
	persistent(0) if anim != [5111, 5119] {
		changeAnim{value: 5110}
	}
}
if !alive && ($atEq0OrSv0 || anim = [5110, 5119]) {
	changeState{value: 5150}
}
if alive && time >= 3 && time <= 10 && (command = "recovery" ||
	command = "holdfwd" || command = "holdback" || command = "holdup") {
	changeState{value: 5120}
}
if time = 0 {
	sysVar(0) := 0;
}
velMul{x: .85}
if abs(vel x) < const(movement.down.friction.threshold) {
	velSet{x: 0}
}
if time = 0 {
	if alive {
		forceFeedback{time: 8; ampl: 240; waveform: sine}
	} else {
		forceFeedback{time: 30; ampl: 200, 7, -.467; waveform: sine}
	}
}

#-------------------------------------------------------------------------------
# Downed get-hit (getting up)
[StateDef 5120; type: L; movetype: I; physics: N;]

if time = 0 {
	let a = call IkSys_SelfAnimExistAddMod10(anim = [5111, 5119], 5120);
	changeAnim{value: $a}
	velSet{x: 0}
}
notHitBy{value: SCA; time: 1}
if animTime = 0 {
	hitFallSet{value: 1} # This seems to have been a typo in the original common1.cns, but it is harmless anyway
	notHitBy{value: , NT,ST,HT; time: 12}
	notHitBy{value2: SCA; time: 3}
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Downed get-hit (lying defeated)
[StateDef 5150; type: L; movetype: H; physics: N; sprpriority: -3; ctrl: 0;]

if time = 0 {
	let a = call IkSys_SelfAnimExistAddMod10(anim = [5111, 5119] ||
		anim = [5171, 5179], 5140);
	if selfAnimExist($a) {
		changeAnim{value: $a}
	}
	if anim != [5140, 5159] && anim != [5110, 5119] {
		changeAnim{value: 5110}
	}
}
persistent(0) if MatchOver = 1 && anim = [5140, 5149] &&
	selfAnimExist(anim + 10) {
	changeAnim{value: anim + 10}
}
velMul{x: .85}
persistent(0) if abs(vel x) < const(movement.down.friction.threshold) {
	velSet{x: 0}
}
notHitBy{value: SCA; time: 1}

#-------------------------------------------------------------------------------
# Air get-hit (fall recovery on ground; still falling)
[StateDef 5200; type: A; movetype: H; physics: N;]

if anim = 5035 && animTime = 0 {
	changeAnim{value: 5050}
}
if time > 0 {
	velAdd{y: getHitVar(yAccel)}
}
if vel y > 0 && pos y >= const(movement.air.gethit.groundrecover.groundlevel) {
	selfState{value: 5201}
}

#-------------------------------------------------------------------------------
# Air get-hit (fall recovery on ground)
[StateDef 5201; type: A; movetype: H; physics: A; anim: 5200;]

if time = 0 {
	if p2Dist x < const240p(-5) {
		turn{}
	}
	velSet{
		x: const(velocity.air.gethit.groundrecover.x);
		y: const(velocity.air.gethit.groundrecover.y);
	}
	posSet{y: 0}
	palFx{time: 3; add: 128, 128, 128}
	if mugenVersion(major) = 1 {
		explod{
			anim: F60;
			postype: none;
			pos: pos x + cameraPos x, pos y - floor(vel y), pos z;
			facing: facing;
			sprpriority: -10
		}
	}
} else if time = 1 && mugenVersion(major) = 0 {
	gameMakeAnim{value: 60; pos: 0, 0; under: 1}
}
notHitBy{value: SCA; time: 1}

#-------------------------------------------------------------------------------
# Air get-hit (fall recovery in air)
[StateDef 5210; type: A; movetype: I; physics: N; anim: 5210; ctrl: 0;]

if time = 0 {
	palFx{time: 3; add: 128, 128, 128}
	posFreeze{}
	if p2Dist x < const240p(-20) {
		turn{}
	}
	notHitBy{value: SCA; time: 15}
} else if time < 4 {
	if mugenVersion(major) = 1 {
		posFreeze{}
	}
} else {
	if time = 4 {
		velMul{
			x: const(velocity.air.gethit.airrecover.mul.x);
			y: const(velocity.air.gethit.airrecover.mul.y);
		}
		velAdd{
			x: const(velocity.air.gethit.airrecover.add.x);
			y: const(velocity.air.gethit.airrecover.add.y);
		}
		if mugenVersion(major) = 0 {
			if vel y > 0 {
				velMul{y: .5}
			}
			if vel y > -3 {
				velAdd{y: -2}
			}
			if vel y > -2 {
				velAdd{y: -1}
			}
		}
		if command = "holdup" {
			velAdd{y: const(velocity.air.gethit.airrecover.up)}
		}
		if command = "holddown" {
			velAdd{y: const(velocity.air.gethit.airrecover.down)}
		}
		if command = "holdfwd" {
			velAdd{x: const(velocity.air.gethit.airrecover.fwd)}
		}
		if command = "holdback" {
			velAdd{x: const(velocity.air.gethit.airrecover.back)}
		}
	} else if time = 20 {
		ctrlSet{value: 1}
	}
	velAdd{y: const(movement.air.gethit.airrecover.yAccel)}
}
if vel y > 0 && pos y >= 0 {
	changeState{value: 52; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Continue screen animation
[StateDef 5500; type: S; ctrl: 0; anim: 5300; velset: 0, 0;]

if time = 0 && selfAnimExist(5500) {
	changeAnim{value: 5500}
}

#-------------------------------------------------------------------------------
# Initialize (at the start of the round)
[StateDef 5900; type: S;]

if roundsExisted = 0 {
	varRangeSet{value: 0}
	varRangeSet{fvalue: 0}
}
remapPal{source: 1, 1; dest: 1, palNo}
if roundNo = 1 {
	changeState{value: 190}
}
changeState{value: 0}

#===============================================================================
# MODERN SYSTEMS - NEW STATES
#===============================================================================
[Function IkSys_AnimOr(a, b) ret]
let ret = ifElse(selfAnimExist($a), $a, $b);

#-------------------------------------------------------------------------------
# Air dash. Gauge-free, once per jump (sysVar(3)). sysVar(1) = direction.
[StateDef 6000; type: A; physics: N; movetype: I; ctrl: 0; sprpriority: 1;]

if time = 0 {
	sysVar(3) := sysVar(3) + 1;
	let a = call IkSys_AnimOr(6000 + (sysVar(1) < 0), 41);
	changeAnim{value: $a}
	velSet{
		x: ifElse(sysVar(1) > 0, const(velocity.run.fwd.x) * 1.4,
			const(velocity.run.back.x) * 1.4);
		y: 0;
	}
	afterImage{time: 14; length: 6; timegap: 1; framegap: 2}
}
assertSpecial{flag: noAutoTurn}
velSet{y: 0}
if time = 9 {
	ctrlSet{value: 1}
}
if pos y >= 0 {
	posSet{y: 0}
	changeState{value: 52}
} else if time >= 14 {
	velMul{x: .5}
	changeState{value: 50; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Drive Parry: tap window. Frames 0-3 are a Perfect Parry, 4-19 a normal parry,
# then a short whiff recovery. Costs 200 gauge to start.
[StateDef 6100; type: U; physics: U; movetype: I; ctrl: 0; sprpriority: 1;]

call IkSys_HiToLoAndLoToHi();
if time = 0 {
	sysFVar(0) := sysFVar(0) - 200;
	let a = call IkSys_AnimOr(6100 + (stateType = C), 130 + (stateType = C));
	changeAnim{value: $a}
	if stateType = C {
		stateTypeSet{physics: C}
	} else {
		stateTypeSet{physics: S}
	}
}
if time <= 3 {
	hitOverride{attr: SCA, NA, SA, HA, NP, SP, HP; slot: 1; stateno: 6111;
		time: 1; forceair: 0}
} else {
	hitOverride{attr: SCA, NA, SA, HA, NP, SP, HP; slot: 1; stateno: 6110;
		time: 1; forceair: 0}
}
if time >= 20 {
	changeState{value: 6120}
}

#-------------------------------------------------------------------------------
# Drive Parry success (costs 100 more gauge)
[StateDef 6110; type: U; movetype: I; physics: U; ctrl: 0;]

call IkSys_HiToLoAndLoToHi();
if time = 0 {
	sysFVar(0) := sysFVar(0) - 100;
	let a = call IkSys_AnimOr(6110, 130);
	changeAnim{value: $a}
	palFx{time: 6; add: 40, 40, 90}
}
if time >= 4 && command = "holdfwd" && (command = "y" || command = "b") &&
	sysFVar(0) >= 1000 && sysFVar(1) = 0 {
	changeState{value: 6200}
}
if time >= 18 {
	changeState{value: ifElse(stateType = C, 11, 0); ctrl: 1}
}

#-------------------------------------------------------------------------------
# Perfect Parry: gauge refund, short recovery, easy Rush cancel
[StateDef 6111; type: U; movetype: I; physics: U; ctrl: 0;]

call IkSys_HiToLoAndLoToHi();
if time = 0 {
	sysFVar(0) := sysFVar(0) + 400;
	let a = call IkSys_AnimOr(6110, 130);
	changeAnim{value: $a}
	palFx{time: 10; add: 100, 100, 200}
}
if time >= 2 && command = "holdfwd" && (command = "y" || command = "b") &&
	sysFVar(0) >= 1000 && sysFVar(1) = 0 {
	changeState{value: 6200}
}
if time >= 10 {
	changeState{value: ifElse(stateType = C, 11, 0); ctrl: 1}
}

#-------------------------------------------------------------------------------
# Drive Parry whiff recovery (punishable)
[StateDef 6120; type: U; movetype: I; physics: U; ctrl: 0;]

call IkSys_HiToLoAndLoToHi();
if time = 0 {
	let a = call IkSys_AnimOr(6120 + (stateType = C), 140 + (stateType = C));
	changeAnim{value: $a}
}
if time >= 12 {
	changeState{value: ifElse(stateType = C, 11, 0); ctrl: 1}
}

#-------------------------------------------------------------------------------
# Drive Rush: 1 bar out of a parry, 3 bars as an attack cancel
[StateDef 6200; type: S; movetype: I; physics: N; ctrl: 0; sprpriority: 1;]

if time = 0 {
	let cost = ifElse(prevStateNo = [6100, 6111], 1000, 3000);
	sysFVar(0) := sysFVar(0) - $cost;
	let a = call IkSys_AnimOr(6200, 100);
	changeAnim{value: $a}
	velSet{x: const(velocity.run.fwd.x) * 2.6; y: 0}
	afterImage{time: 20; length: 7; timegap: 1; framegap: 2}
	palFx{time: 4; add: 50, 50, 50}
}
velMul{x: .93}
assertSpecial{flag: noWalk; flag2: noAutoTurn}
if time = 8 {
	ctrlSet{value: 1}
}
if time >= 22 || abs(vel x) < const(movement.stand.friction.threshold) {
	velSet{x: 0}
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Drive Impact (startup). Armor absorbs one hit. Costs 1000.
[StateDef 6300; type: S; movetype: A; physics: S; ctrl: 0; velset: 0, 0;
	sprpriority: 2;]

if time = 0 {
	sysFVar(0) := sysFVar(0) - 1000;
	let a = call IkSys_AnimOr(6300, 200);
	changeAnim{value: $a}
	palFx{time: 14; add: 60, 30, 0}
}
hitOverride{attr: SCA, AA; slot: 2; stateno: 6310; time: 1; forceair: 0}
if time >= 14 {
	changeState{value: 6301}
}

#-------------------------------------------------------------------------------
# Drive Impact (armor absorbed a hit: flash, then commit to the attack)
[StateDef 6310; type: S; movetype: A; physics: N; ctrl: 0; velset: 0, 0;
	sprpriority: 2;]

if time = 0 {
	palFx{time: 8; add: 120, 120, 120}
}
if time >= 4 {
	changeState{value: 6301}
}

#-------------------------------------------------------------------------------
# Drive Impact (active). Also used by Drive Reversal.
[StateDef 6301; type: S; movetype: A; physics: S; ctrl: 0; sprpriority: 2;]

if time = 0 {
	if selfAnimExist(6301) {
		changeAnim{value: 6301}
	}
	hitDef{
		attr: S, SA;
		damage: 60, 0;
		animtype: Heavy;
		guardflag: MA;
		hitflag: MAF;
		pausetime: 12, 14;
		sparkno: 3;
		sparkxy: -10, -60;
		hitsound: F5, 3;
		guardsound: F6, 0;
		ground.type: High;
		ground.slidetime: 14;
		ground.hittime: 20;
		ground.velocity: -7, -4;
		air.velocity: -3, -4;
		guard.slidetime: 14;
		guard.hittime: 14;
		guard.ctrltime: 14;
		guard.velocity: -8;
		fall: 1;
		fall.recover: 0;
		p1sprpriority: 2;
	}
}
if animTime = 0 || time >= 40 {
	changeState{value: 0; ctrl: 1}
}

#-------------------------------------------------------------------------------
# Drive Reversal: guard cancel, 2000 gauge, 8 frames invulnerable, then Impact
[StateDef 6400; type: S; movetype: A; physics: S; ctrl: 0; velset: 0, 0;
	sprpriority: 2;]

if time = 0 {
	sysFVar(0) := sysFVar(0) - 2000;
	let a = call IkSys_AnimOr(6300, 200);
	changeAnim{value: $a}
	notHitBy{value: SCA; time: 8}
	palFx{time: 10; add: 80, 0, 80}
}
if time >= 8 {
	changeState{value: 6301}
}

#-------------------------------------------------------------------------------
# Overdrive Burst: escape hitstun for 3000 gauge. Invulnerable, no damage,
# shoves the opponent away.
[StateDef 6410; type: U; movetype: A; physics: N; ctrl: 0; velset: 0, 0;
	sprpriority: 3;]

if time = 0 {
	sysFVar(0) := sysFVar(0) - 3000;
	let a = call IkSys_AnimOr(6410, 5210);
	changeAnim{value: $a}
	notHitBy{value: SCA; time: 14}
	palFx{time: 12; add: 160, 160, 60}
	envShake{time: 6; ampl: 3}
	hitDef{
		attr: S, SA;
		damage: 0, 0;
		animtype: Heavy;
		guardflag: MA;
		hitflag: MAF;
		pausetime: 8, 8;
		sparkno: 3;
		sparkxy: 0, -60;
		ground.type: High;
		ground.slidetime: 16;
		ground.hittime: 16;
		ground.velocity: -9, -3;
		air.velocity: -8, -4;
		guard.slidetime: 16;
		guard.hittime: 16;
		guard.velocity: -10;
		fall: 1;
		fall.recover: 1;
		p1sprpriority: 3;
	}
}
if pos y < 0 {
	velAdd{y: const(movement.yAccel)}
}
if vel y > 0 && pos y >= 0 {
	velSet{y: 0}
	posSet{y: 0}
	stateTypeSet{statetype: S}
}
if time >= 22 {
	changeState{value: ifElse(pos y < 0, 50, 0); ctrl: 1}
}

#-------------------------------------------------------------------------------
# Drive Stun (guard crush): block with an empty Drive Gauge. 50 frames, open
# to everything.
[StateDef 6500; type: S; movetype: H; physics: S; ctrl: 0; velset: 0, 0;]

if time = 0 {
	let a = call IkSys_AnimOr(6500, ifElse(selfAnimExist(5300), 5300, 5002));
	changeAnim{value: $a}
	envShake{time: 6; ampl: 3}
	forceFeedback{waveform: square; time: 12}
}
if time % 6 < 3 {
	palFx{time: 1; add: 120, 0, 0}
}
if time >= 50 {
	changeState{value: 0; ctrl: 1}
}

#===============================================================================
# GLOBAL PER-FRAME LOGIC
# Runs for every character without any CMD edits. If a build of Ikemen does
# not execute [StateDef -2] from the common states file, copy this block into
# the character's own [StateDef -2].
#===============================================================================
[StateDef -2]

if !isHelper {
	# --- Round start: full Drive Gauge, no burnout ---
	if roundState < 2 {
		sysFVar(0) := 6000;
		sysFVar(1) := 0;
		sysFVar(2) := 0;
		sysVar(3) := 0;
		sysVar(4) := 0;
	}

	# --- Block: Just Defend / Instant Block (fresh back tap within 7 frames
	# of the hit) refunds 300 gauge and a sliver of life and recovers faster;
	# a normal block drains 250 gauge ---
	if command = "holdback" {
		if sysVar(4) < 200 {
			sysVar(4) := sysVar(4) + 1;
		}
	} else {
		sysVar(4) := 0;
	}
	if (stateNo = 150 || stateNo = 152 || stateNo = 154) && time = 0 {
		if command = "holdback" && sysVar(4) <= 7 {
			sysFVar(2) := 1;
			sysFVar(0) := sysFVar(0) + 300;
			lifeAdd{value: 8; kill: 0; absolute: 1}
			palFx{time: 8; add: 80, 80, 40}
		} else {
			sysFVar(2) := 0;
			sysFVar(0) := sysFVar(0) - 250;
		}
	}
	if stateNo != [150, 155] {
		sysFVar(2) := 0;
	}

	# --- Gauge regen / burnout (regen 5/frame, 7 in burnout; burnout ends
	# when the gauge is full) ---
	if roundState = 2 {
		if sysFVar(0) < 6000 && moveType = I && stateNo != [6100, 6499] {
			sysFVar(0) := sysFVar(0) + ifElse(sysFVar(1) = 1, 7, 5);
		}
		if sysFVar(0) > 6000 {
			sysFVar(0) := 6000;
		}
		if sysFVar(0) <= 0 {
			sysFVar(0) := 0;
			sysFVar(1) := 1;
		}
		if sysFVar(1) = 1 && sysFVar(0) >= 6000 {
			sysFVar(1) := 0;
		}
	}

	# --- Air dash counter resets on landing ---
	if stateType != A {
		sysVar(3) := 0;
	}

	# --- Combo scaling: each hit lowers the next hit's damage by 10%, floor
	# 20%. DefenceMulSet divides damage; if scaling feels inverted in your
	# build, replace "1 / $s" with "$s". ---
	if (stateNo = 5000 || stateNo = 5010 || stateNo = 5020 || stateNo = 5070 ||
		stateNo = 5080) && time = 0 {
		let hc = getHitVar(hitCount);
		let s = ifElse(1 - .1 * ($hc - 1) < .2, .2, 1 - .1 * ($hc - 1));
		defenceMulSet{value: 1 / $s}
	}
	if time = 0 && (stateNo = 0 || stateNo = 52 || stateNo = 5120) {
		defenceMulSet{value: 1}
	}

	# --- Guard crush: the block that empties the gauge ---
	if (stateNo = 150 || stateNo = 152) && time = 0 && sysFVar(1) = 1 &&
		sysFVar(0) <= 0 {
		changeState{value: 6500}
	}

	# --- Inputs (only one fires per frame, highest priority first) ---
	if roundState = 2 && alive {
		let free = sysFVar(1) = 0;
		let btnParry = command = "y" && command = "b";
		let btnImpact = command = "z" && command = "c";
		if (stateNo = 5000 || stateNo = 5010 || stateNo = 5020 ||
			stateNo = 5030 || stateNo = 5035) && time >= 2 &&
			command = "recovery" && $free && sysFVar(0) >= 3000 {
			changeState{value: 6410}
		} else if (stateNo = 130 || stateNo = 131 || stateNo = 151 ||
			stateNo = 153) && $btnImpact && command = "holdfwd" && $free &&
			sysFVar(0) >= 2000 {
			changeState{value: 6400}
		} else if movetype = A && moveContact && stateType != A && $btnParry &&
			command = "holdfwd" && $free && sysFVar(0) >= 3000 {
			changeState{value: 6200}
		} else if (ctrl || stateNo = 130 || stateNo = 131) && stateType != A &&
			$btnParry && $free && sysFVar(0) > 0 {
			changeState{value: 6100}
		} else if ctrl && stateType != A && $btnImpact && $free &&
			sysFVar(0) >= 1000 {
			changeState{value: 6300}
		} else if ctrl && stateType = A && $btnParry && sysVar(3) < 1 &&
			pos y < const240p(-24) {
			sysVar(1) := ifElse(command = "holdback", -1, 1);
			changeState{value: 6000}
		}
	}

	# Optional: mirror the gauge onto the power bar to get a built-in HUD
	# powerSet{value: floor(sysFVar(0) / 6000 * powerMax)}
}
